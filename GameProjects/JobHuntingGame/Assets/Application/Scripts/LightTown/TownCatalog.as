#include "TownBuildings.as"
class TownBuildChoice {int kind=6,tier=0,recipe=0;}
array<TownBuildChoice@>@ TownBuildCatalog(){array<TownBuildChoice@>@ result=array<TownBuildChoice@>();array<int> kinds={6,0,1,2,3,4,7,5};for(uint k=0;k<kinds.length();++k){int kind=kinds[k],recipes=kind==2?3:1,tiers=kind>=1&&kind<=4?3:1;for(int r=0;r<recipes;++r)for(int t=0;t<tiers;++t){TownBuildChoice@ c=TownBuildChoice();c.kind=kind;c.tier=t;c.recipe=r;result.insertLast(c);}}return result;}
string TownCost(Json@ d){return TownTr("木 ","W ")+d.GetInt("wood")+" / "+TownTr("石 ","S ")+d.GetInt("stone")+" / "+TownTr("結晶 ","C ")+d.GetInt("crystal")+"\n"+TownTr("加工木 ","Planks ")+d.GetInt("planks")+" / "+TownTr("加工石 ","Masonry ")+d.GetInt("masonry")+" / "+TownTr("加工晶 ","Refined ")+d.GetInt("refinedCrystal");}
string TownDescription(TownState@ state,Json@ d){int kind=int(d.GetInt("kind",-1)),tier=int(d.GetInt("tier")),width=int(d.GetInt("size",1)),scale=state.Capacity(d);string text=TownBuildingName(d)+" / "+width+"×"+width+"\n"+TownCost(d)+"\n";
 if(kind==0)text+=TownTr("光 +12 / 10秒、治安 +","Light +12 / 10s, safety +")+state.Balance("streetlightSafety",0,2);
 if(kind==1)text+=TownTr("人口 +","Population +")+state.Residents(d)+TownTr(" / 治安 "," / safety ")+state.Balance("housingSafety",tier,-(2+tier*tier*4))+"\n"+TownTr("幸福 +","Happiness +")+state.Balance("housingHappiness",tier,1+tier*2);
 if(kind==2){array<string> n={TownTr("加工木材","Planks"),TownTr("加工石材","Masonry"),TownTr("加工光結晶","Refined crystal")};text+=n[uint(d.GetInt("recipe"))]+" +"+scale+TownTr(" / 10秒\n原料 -"," / 10s\nRaw input -")+(scale*state.Balance("processingInput",0,2))+TownTr(" / 光 -"," / light -")+(scale*state.Balance("processingEnergy",0,4))+"\n"+TownTr("住居への被害：半径 ","Housing impact: radius ")+state.Balance("pollutionRadius",tier,2+tier)+TownTr("セル / 幸福 -"," cells / happiness -")+state.Balance("pollution",tier,2+tier*3);}
 if(kind==3)text+=TownTr("ショップ規模 ","Shop tier ")+(tier+1)+TownTr(" / 光 -2 / 10秒\n商品の拡張は準備中"," / light -2 / 10s\nMore products are planned");
 if(kind==4)text+=TownTr("派遣報酬 ","Dispatch yield ")+scale+TownTr("倍 / 45秒\n光 -3 / 10秒","x / 45s\nLight -3 / 10s");
 if(kind==7)text+=TownTr("治安 +","Safety +")+state.Balance("policeSafety",0,18)+TownTr("（建築時）\n光 -2 / 10秒"," on construction\nLight -2 / 10s");
 if(kind==5)text+=TownTr("街づくりの最終目標","The town's final goal");if(kind!=6)text+="\n"+TownTr("建築時：繁栄 +","On construction: prosperity +")+state.Balance("prosperity",tier,tier==0?5:(tier==1?12:30));if(kind!=6)text+="\n"+TownTr("入口正面の道路・街灯の照明が必要","Requires a road at the entrance and lighting");return text;}
