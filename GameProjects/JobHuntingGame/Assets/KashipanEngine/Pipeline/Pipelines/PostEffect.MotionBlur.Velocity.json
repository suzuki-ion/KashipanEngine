{
	"PipelineType": "Render",
	"Name": "PostEffect.MotionBlur.Velocity",
	"Category": "PostEffect",
	"Shader": {
		"AutoTopologyFromShaders": true,
		"AutoInputLayoutFromVS": true,
		"AutoRTCountFromPS": true,
		"AutoRootDescriptorFromShader": true,
		"Vertex": {
			"UsePreset": "MotionBlur.Velocity.Vertex"
		},
		"Pixel": {
			"UsePreset": "MotionBlur.Velocity.Pixel"
		}
	},
	"RasterizerState": {
		"UsePreset": "Solid"
	},
	"BlendState": {
		"UsePreset": "None"
	},
	"DepthStencilState": {
		"UsePreset": "DepthDisable"
	},
	"PipelineState": {
		// 速度バッファはRG16Float（MotionBlurEffect::kVelocityFormat参照）。ピクセルシェーダーも
		// float2しか出力しないため、既定のTriangleプリセット（RTVFormatsがB8G8R8A8_UNORM）を
		// 使うとRTVのチャンネル数とPS出力が食い違い、D3D12デバッグレイヤーの警告が出る
		"NumRenderTargets": 1,
		"RTVFormats": [ "DXGI_FORMAT_R16G16_FLOAT" ],
		"PrimitiveTopologyType": "D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE",
		"SampleDesc": {
			"Count": 1,
			"Quality": 0
		},
		"SampleMask": "D3D12_DEFAULT_SAMPLE_MASK",
		"DSVFormat": "DXGI_FORMAT_D24_UNORM_S8_UINT"
	}
}
