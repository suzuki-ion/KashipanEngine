{
	// このプロジェクト（アプリケーション）固有の翻訳ファイル。
	//
	// エンジン共通の翻訳はエンジンルート直下の Locales/ja-JP.json にあり、
	// このファイルはその後から読み込まれて「重ねられる」。
	//   ・エンジンに無いキーを書けば、アプリ独自の翻訳として追加される
	//   ・エンジンと同じキーを書けば、このプロジェクトでだけ文言を差し替えられる
	//
	// 読み込む対象は EngineSettings.json の translations セクションで指定する。
	// localeCode は必須。localeName / fontPath は省略でき、
	// 省略した場合はエンジン共通の翻訳ファイルの値がそのまま使われる。
	"localeCode": "ja-JP",
	"translations": {
		//==================================================
		// アプリケーション固有の翻訳
		//==================================================
		// 例）
		// "app.title": "ゲームタイトル",
		// "app.ui.start": "はじめる"
	}
}
