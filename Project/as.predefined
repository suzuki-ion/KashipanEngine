	string[]@ GetKeys() const;
	void SetBool(const string&in key, bool value);
	void SetInt(const string&in key, int64 value);
	void SetFloat(const string&in key, double value);
	void SetString(const string&in key, const string&in value);
	void SetVector2(const string&in key, const Vector2&in value);
	void SetVector3(const string&in key, const Vector3&in value);
	void SetVector4(const string&in key, const Vector4&in value);
	void SetQuaternion(const string&in key, const Quaternion&in value);
	void SetJson(const string&in key, const Json&in value);
	void SetNull(const string&in key);
	bool Set(const string&in key, const ?&in value);
	bool Get(const string&in key, ?&out value) const;
	bool GetBool(const string&in key, bool defaultValue = false) const;
	int64 GetInt(const string&in key, int64 defaultValue = 0) const;
	double GetFloat(const string&in key, double defaultValue = 0) const;
	string GetString(const string&in key, const string&in defaultValue = "") const;
	Vector2 GetVector2(const string&in key, const Vector2&in defaultValue = Vector2()) const;
	Vector3 GetVector3(const string&in key, const Vector3&in defaultValue = Vector3()) const;
	Vector4 GetVector4(const string&in key, const Vector4&in defaultValue = Vector4()) const;
	Quaternion GetQuaternion(const string&in key, const Quaternion&in defaultValue = Quaternion()) const;
	Json@ GetJson(const string&in key) const;
	uint Size() const;
	Json@ At(uint index) const;
	void PushBool(bool value);
	void PushInt(int64 value);
	void PushFloat(double value);
	void PushString(const string&in value);
	void PushJson(const Json&in value);
	bool Push(const ?&in value);
	bool AsBool(bool defaultValue = false) const;
	int64 AsInt(int64 defaultValue = 0) const;
	double AsFloat(double defaultValue = 0) const;
	string AsString(const string&in defaultValue = "") const;
	string ToString(int indent = -1) const;
	bool Parse(const string&in text);
}

